# ============================================================================
# Profil target
# ============================================================================
# Menentukan berkas .env.<profil> mana yang dilapiskan di atas .env ini:
#   APP_MODE=dev   -> .env.dev   (staging)
#   APP_MODE=prod  -> .env.prod  (produksi via api-server_LOADTEST)
#
# Dengan APP_MODE terisi, perintah cukup ditulis biasa:
#   python tests/t1_service_time.py
#
# Masih bisa ditimpa sekali jalan dari shell, dan shell selalu menang:
#   PROFILE=prod python tests/t1_service_time.py
APP_MODE=dev

# ============================================================================
# Target API
# ============================================================================
# Dua cara menembak produksi — pilih salah satu:
#
# (A) AUTH_MODE=gateway -> lewat gateway ke api-server_PROD
#     Jalur normal. TAPI memicu cascade: parsing -> analisis (LLM berbayar)
#     -> dispatch eKlaim. Pakai ini hanya kalau memang ingin mengukur
#     pipeline penuh dan siap dengan biaya token + kontensi server eKlaim.
#
# (B) AUTH_MODE=direct -> lewat api-server_LOADTEST          [DISARANKAN]
#     Container tambahan dengan IS_CODEX_API_V2_PROCESS=false; lihat
#     docker-compose.loadtest.yml. Cascade berhenti di worker parsing.
#     Tidak lewat gateway, jadi kirim X-Consumer-Custom-ID sendiri.
#     Akses lewat SSH tunnel:
#       ssh -N -L 8099:127.0.0.1:<LOADTEST_API_PORT> user@server
#       API_BASE_URL=http://127.0.0.1:8099

API_BASE_URL=https://api.serenic.ai
API_V2_PREFIX=/integrations/v2

AUTH_MODE=gateway

# AUTH_MODE=gateway -> dikirim sebagai header `apiKey`
API_KEY=

# AUTH_MODE=direct -> dikirim sebagai header `X-Consumer-Custom-ID`
CONSUMER_ID=

# Label organisasi, opsional. Hanya dipakai untuk penamaan hasil.
ORG_LABEL=

# Basic auth kalau API di belakang gateway yang memintanya (opsional)
API_BASIC_AUTH_USER=
API_BASIC_AUTH_PASS=

# Guard produksi. Harus 1 secara eksplisit kalau API_BASE_URL mengandung
# "api.serenic.ai". Baca bagian "Menguji di produksi" di README dulu.
ALLOW_PROD=0

# ============================================================================
# Redis (untuk membaca antrean & timing job RQ)
# ============================================================================
# Kalau Redis tidak diekspos publik, buat SSH tunnel dulu:
#   ssh -N -L 6380:127.0.0.1:6379 user@server
# lalu REDIS_URL=redis://127.0.0.1:6380/0
REDIS_URL=redis://127.0.0.1:6379/0

# Nilai dari INTEGRATION_DATA_PARSING_AGENT_QUEUE_NAME di prod.env server.
# Verifikasi dengan: python tools/inspect_redis.py
PARSING_QUEUE=

# Jumlah replika emr-integration-data-parsing-worker_PROD yang sedang jalan.
# Satu container RQ mengerjakan SATU job pada satu waktu, jadi ini = konkurensi
# parsing. Harness memakainya untuk menghitung kapasitas armada dan utilisasi.
WORKER_REPLICAS=4

# Antrean hilir — dipantau untuk membuktikan tidak ada cascade saat isolasi.
ANALYSIS_COORDINATOR_QUEUE=
ANALYSIS_QUEUE=

# ============================================================================
# Payload
# ============================================================================
# Template payload asli (satu encounter penuh). Dipakai sebagai bahan kloning.
TEMPLATE_PAYLOAD=payload-sample.json

# Prefix identifier untuk semua data sintetis, supaya gampang dibersihkan nanti.
SYNTHETIC_PREFIX=LT

# Master data yang dipakai encounter sintetis. Kosongkan untuk memakai objek
# inline yang dibuat harness (self-contained). Isi dengan id asli dari
# GET /integrations/v2/prerequisites kalau ingestor menolak objek inline.
LOCATION_ID=
DPJP_ID=

# Kirim performer_id / result_interpreter_id sebagai objek PractitionerModel
# inline, bukan string id. Mengaktifkan jalur _ingest_practitioner di worker.
#
# PERINGATAN: objek inline memicu upsert master data praktisi. Harness mengisi
# `name` dengan id-nya sendiri supaya nama praktisi yang sudah ada TIDAK
# ditimpa (lihat ingestor.py:865), tapi `profession` tetap ditulis dan akan
# menimpa kalau berbeda. Karena itu pakai ORGANISASI KHUSUS TEST — di sana
# praktisi belum ada sehingga hanya dibuat baru, tidak ada yang diubah.
PERFORMER_AS_OBJECT=1
PERFORMER_PROFESSION=Dokter

# ============================================================================
# Output
# ============================================================================
RESULTS_DIR=results

# Arsip request dan response, mengikuti konvensi server:
#   payload/{ORGID}/{yyyymmdd}/{nama_endpoint}_{timestamp}_{seq}.json
#   response/{ORGID}/{yyyymmdd}/{nama_endpoint}_{timestamp}_{seq}.json
# Nomor {seq} sama untuk pasangan request-response, jadi mudah ditelusuri.
# Ditulis di thread terpisah supaya tidak mencemari pengukuran latency.
SAVE_PAYLOADS=1
PAYLOAD_DIR=payload
SAVE_RESPONSES=1
RESPONSE_DIR=response

# Nama folder organisasi untuk arsip. Kalau kosong, jatuh ke ORG_LABEL lalu
# CONSUMER_ID.
ORGID=

# Pengaman disk. Satu encounter ~53 KB, jadi T3 panjang bisa menghasilkan
# puluhan GB. Setelah batas ini tercapai, penyimpanan berhenti (test tetap jalan).
PAYLOAD_MAX_MB=2000
RESPONSE_MAX_MB=500